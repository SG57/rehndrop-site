---
import Base from '../layouts/Base.astro';
import StorePills from '../components/StorePills.astro';
import Spotlight from '../components/Spotlight.astro';
import Index from '../components/Index.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { data, rows, curation, type Track } from '../lib/data';
import { BIO, u } from '../lib/site';

const r = rows();
const site = Astro.site!;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'rehndrop',
  url: new URL(u(), site).href,
  image: new URL(u('og.jpg'), site).href,
  genre: ['dubstep', 'riddim', 'glitch hop', 'future bass'],
  email: curation.contact,
  sameAs: [...Object.values(curation.stores), ...Object.values(curation.socials)],
  track: data.tracks.map((t) => ({
    '@type': 'MusicRecording',
    name: t.title,
    url: new URL(u(`t/${t.slug}/`), site).href,
    ...(t.released ? { datePublished: t.released } : {}),
  })),
};

// picks.: Cord's picks, then his spotlight, each track once
const picks = [...new Set([...curation.picks, ...curation.spotlight])]
  .map((s) => data.bySlug.get(s))
  .filter((t): t is Track => !!t);
const reels = [...data.reels].sort((a, b) => b.postedAt.localeCompare(a.postedAt));
const sections = [
  { id: 'picks', title: 'picks.', kind: 'tracks' as const, items: picks },
  { id: 'newest', title: 'the new stuff.', kind: 'tracks' as const, items: r.newest },
  { id: 'reels', title: 'reels.', kind: 'reels' as const, items: reels },
  { id: 'heavy', title: 'the heavy stuff.', kind: 'tracks' as const, items: r.heavy },
  { id: 'pretty', title: 'the pretty stuff.', kind: 'tracks' as const, items: r.pretty },
  { id: 'detox', title: 'the detox stuff.', kind: 'tracks' as const, items: r.detox },
  { id: 'videos', title: 'videos.', kind: 'videos' as const, items: r.videos },
  { id: 'early', title: 'the old stuff.', kind: 'tracks' as const, items: r.early },
];
// the chip row: until the stage takes lenses, each chip is a plain jump to its section
const chips = [
  ['picks', 'picks'],
  ['newest', 'new'],
  ['reels', 'reels'],
  ['heavy', 'heavy'],
  ['pretty', 'pretty'],
  ['detox', 'detox'],
  ['early', 'old'],
].filter(([id]) => sections.some((s) => s.id === id && s.items.length > 0));
---
<Base title="rehndrop · bass music" description={BIO} tracks={data.tracks} jsonLd={jsonLd} home>
  <main id="main">
    <nav class="chips" aria-label="sections">
      {chips.map(([id, label]) => <a class="chip" href={`#${id}`}>{label}</a>)}
    </nav>
    <div class="stage">
      <section class="welcome" aria-label="rehndrop">
        <h1 class="sr-only">rehndrop</h1>
        <div class="r-stage" data-tilt>
          <div class="r">
            <span class="r-shade" aria-hidden="true"></span>
            <span class="r-glow" aria-hidden="true"></span>
            <img class="r-img" src={u('brand/r-chrome-640.webp')} srcset={`${u('brand/r-chrome-640.webp')} 640w, ${u('brand/r-chrome-1200.webp')} 1200w`} sizes="(orientation: landscape) and (max-height: 520px) 34vh, (min-width: 900px) 300px, 46vw" width="640" height="669" alt="rehndrop" fetchpriority="high" />
            <span class="r-sheen" aria-hidden="true" style={`--mask:url(${u('brand/r-mask-640.png')})`}></span>
          </div>
        </div>
        <div class="welcome-copy">
          <p class="bio">the heavy stuff and the pretty stuff.</p>
          <StorePills />
        </div>
        <a class="scroll-cue" href="#spotlight" aria-label="more"><span></span></a>
      </section>

      <Spotlight tracks={data.spotlight} />
      <button class="stage-contact" type="button" data-contact-open aria-haspopup="dialog">booking · press · management</button>
    </div>

    <Index sections={sections} total={data.tracks} />

    <Contact />
    <Footer />
  </main>
</Base>
