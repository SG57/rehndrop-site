---
import { icons, type IconName } from '../lib/site';
interface Props { name: IconName; size?: number }
const { name, size = 18 } = Astro.props;
---
<svg class="icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={icons[name]} fill="currentColor" /></svg>
