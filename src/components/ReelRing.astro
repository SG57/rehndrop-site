---
// The reel ring: any cover of a track with posted reels wears one, a link to that track's
// `reels.` posters (on its own page, an in-page jump).
import type { Track } from '../lib/data';
import { u } from '../lib/site';
interface Props { track: Track; size?: 'sm' | 'lg'; here?: boolean }
const { track: t, size = 'sm', here = false } = Astro.props;
---
{t.reels.length > 0 && (
  <a class:list={['reel-ring', `reel-ring--${size}`]} href={here ? '#reels' : u(`t/${t.slug}/#reels`)} aria-label={`reels for ${t.title}`} title="reels" style={`--ring-accent:${t.accent}`}>
    <span class="reel-ring-halo" aria-hidden="true"></span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="3.5" width="10" height="17" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M10.5 9.5v5l4-2.5z" fill="currentColor" /></svg>
  </a>
)}
