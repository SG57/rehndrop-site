---
// Editorial picks: Cord's own reasons, the lyric verbatim from the lyric file.
import type { Track } from '../lib/data';
import { u } from '../lib/site';
import Cover from './Cover.astro';
import Listen from './Listen.astro';
interface Props { tracks: Track[] }
const { tracks } = Astro.props;
---
<section class="picks" id="picks" aria-label="picks">
  <header class="row-head"><h2 class="row-title">picks.</h2></header>
  <div class="picks-grid">
    {tracks.map((t) => (
      <article class="pick-card" style={`--slide-accent:${t.accent}`}>
        <button class="pick-cover card-art" type="button" data-play={t.slug} aria-label={`preview ${t.title}`} aria-pressed="false">
          {t.cover && <Cover class="card-img" src={t.cover} size={560} widths={[280, 420, 560]} sizes="(min-width: 900px) 260px, 38vw" alt="" />}
          <span class="card-play" aria-hidden="true">
            <span class="play-ring"></span>
            <svg class="play-glyph" viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
            <svg class="pause-glyph" viewBox="0 0 24 24"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" /></svg>
          </span>
        </button>
        <div class="pick-body">
          <a class="pick-title" href={u(`t/${t.slug}/`)}>{t.title}</a>
          {t.story?.quote && <blockquote class="pick-quote">“{t.story.quote}”</blockquote>}
          {t.story?.note && <p class="pick-note">{t.story.note}</p>}
          <Listen track={t} />
        </div>
      </article>
    ))}
  </div>
</section>
