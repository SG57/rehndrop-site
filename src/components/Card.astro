---
// The cover is the play button (the fast, magic path); the title opens the track page.
import type { Track } from '../lib/data';
import { fmtDate } from '../lib/data';
import { u } from '../lib/site';
import Cover from './Cover.astro';
import ReelRing from './ReelRing.astro';
interface Props { track: Track; eager?: boolean }
const { track: t, eager = false } = Astro.props;
// the title answer if there is one, else the track's line; a date only as the last resort
const sub = t.answer ?? t.story?.note ?? fmtDate(t.released);
const href = u(`t/${t.slug}/`);
const sizes = '(min-width: 1100px) 216px, (min-width: 700px) 190px, 40vw';
---
<article class="card" style={`--card-accent:${t.accent}`}>
  {t.preview.src ? (
    <button class="card-art" type="button" data-play={t.slug} aria-label={`preview ${t.title}`} aria-pressed="false">
      {t.cover ? <Cover class="card-img" src={t.cover} size={420} widths={[210, 320, 420]} sizes={sizes} alt="" eager={eager} /> : <span class="card-img card-img--empty" />}
      <span class="card-play" aria-hidden="true">
        <span class="play-ring"></span>
        <svg class="play-glyph" viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
        <svg class="pause-glyph" viewBox="0 0 24 24"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z" fill="currentColor" /></svg>
      </span>
    </button>
  ) : (
    <a class="card-art" href={href} aria-label={t.title}>
      {t.cover ? <Cover class="card-img" src={t.cover} size={420} widths={[210, 320, 420]} sizes={sizes} alt="" eager={eager} /> : <span class="card-img card-img--empty" />}
    </a>
  )}
  <ReelRing track={t} />
  <a class="card-title" href={href}>{t.title}</a>
  {sub && <span class="card-sub">{sub}</span>}
</article>
