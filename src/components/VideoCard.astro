---
import type { Video } from '../lib/data';
interface Props { video: Video; wide?: boolean }
const { video: v, wide = false } = Astro.props;
const label = v.credit ? `${v.title} (${v.credit})` : v.title;
---
<article class:list={['vcard', { 'vcard--wide': wide }]}>
  <button class="vcard-art" type="button" data-video={v.id} data-video-title={label} aria-label={`watch ${label}`}>
    <img src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`} alt="" loading="lazy" decoding="async" width="480" height="360" />
    <span class="vcard-play" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z" fill="currentColor" /></svg>
    </span>
  </button>
  <span class="card-title">{v.title}</span>
  <span class="card-sub">{v.credit ?? v.published.slice(0, 4)}</span>
</article>
