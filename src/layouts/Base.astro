---
import '@fontsource/michroma/400.css';
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import MiniPlayer from '../components/MiniPlayer.astro';
import VideoDialog from '../components/VideoDialog.astro';
import StoryViewer from '../components/StoryViewer.astro';
import type { Track } from '../lib/data';
import { data, fmtDate } from '../lib/data';
import curation from '../data/curation.json';
import { BASE, u } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'music.song';
  tracks: Track[];
  jsonLd?: Record<string, unknown>;
}
const { title, description, image, type = 'website', tracks, jsonLd } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image ?? u('og.jpg'), site).href;

const player = await Promise.all(
  tracks.map(async (t) => ({
    slug: t.slug,
    title: t.title,
    src: t.preview.src,
    env: t.preview.env,
    dropAt: t.preview.dropAt,
    hits: t.preview.hits,
    turns: t.preview.turns,
    duration: t.preview.duration,
    bpm: t.bpm,
    accent: t.accent,
    thumb: t.cover ? (await getImage({ src: t.cover, width: 192, height: 192, format: 'webp', quality: 75 })).src : u('brand/icon-192.png'),
    apple: t.links.apple,
    spotify: t.links.spotify,
    youtube: t.links.youtube,
    href: u(`t/${t.slug}/`),
  })),
);
// every posted reel, for the story viewer; any page can open any track's reels
const stories = await Promise.all(
  data.reels.map(async (r) => ({
    id: r.id,
    track: r.track,
    title: r.title,
    date: fmtDate(r.postedAt) ?? '',
    url: r.url,
    video: r.video,
    poster: r.poster ? (await getImage({ src: r.poster, width: 540, height: 960, format: 'webp', quality: 78 })).src : null,
    href: u(`t/${r.track}/`),
  })),
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#020204" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="rehndrop" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={u('favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
    <link rel="manifest" href={u('site.webmanifest')} />
    <link rel="preload" as="image" href={u('brand/velvet.webp')} type="image/webp" fetchpriority="high" />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <div class="velvet" aria-hidden="true" style={`--velvet:url(${u('brand/velvet.webp')})`}></div>
    <canvas class="lens" aria-hidden="true" data-lens></canvas>
    <div class="grain" aria-hidden="true"></div>
    <slot />
    <div class="drops-layer" aria-hidden="true"><canvas class="drops" data-drops></canvas></div>
    <MiniPlayer />
    <VideoDialog />
    <StoryViewer />
    <script type="application/json" id="story-data" set:html={JSON.stringify(stories)} />
    <script type="application/json" id="player-data" set:html={JSON.stringify(player)} />
    <script is:inline define:vars={{ base: BASE, sharp: u('brand/velvet.webp'), sharp4k: u('brand/velvet-4k.webp'), fog: u('brand/velvet-fog.jpg'), velvet: curation.velvetTint ?? 'little' }}>
      window.__rehndrop = { base, sharp, fog, velvet };
      // retina laptops and 4K screens get the 3840px velvet for both the CSS layer and the lens
      if (innerWidth * (devicePixelRatio || 1) > 2600) {
        window.__rehndrop.sharp = sharp4k;
        document.querySelector('.velvet')?.style.setProperty('--velvet', 'url(' + sharp4k + ')');
      }
    </script>
    <script>
      import { startLens } from '../scripts/lens';
      import { startDrops } from '../scripts/drops';
      import { startPlayer, type PlayerTrack } from '../scripts/player';
      import { startDrag, startRows, startSpotlight, startTilt, startVideos } from '../scripts/ui';
      import { startStories, type StoryReel } from '../scripts/story';

      const cfg = (window as unknown as { __rehndrop: { base: string; sharp: string; fog: string; velvet: string } }).__rehndrop;
      const tracks = JSON.parse(document.getElementById('player-data')!.textContent || '[]') as PlayerTrack[];
      startPlayer(tracks, cfg.base, cfg.velvet);
      startStories(JSON.parse(document.getElementById('story-data')!.textContent || '[]') as StoryReel[], cfg.base);
      startSpotlight();
      startRows();
      startDrag();
      startVideos();
      startTilt();
      const canvas = document.querySelector<HTMLCanvasElement>('[data-lens]');
      if (canvas) startLens({ canvas, sharp: cfg.sharp, fog: cfg.fog, texAspect: 16 / 9 });
      const lensWater = document.querySelector<HTMLCanvasElement>('[data-drops]');
      if (lensWater) startDrops(lensWater);
    </script>
  </body>
</html>
