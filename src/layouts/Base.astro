---
import '@fontsource/michroma/400.css';
import '@fontsource-variable/manrope';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import MiniPlayer from '../components/MiniPlayer.astro';
import ContactSheet from '../components/ContactSheet.astro';
import type { Track } from '../lib/data';
import curation from '../data/curation.json';
import { PHONE_VELVET_MQ } from '../lib/config';
import { BASE, u } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'music.song';
  tracks: Track[];
  jsonLd?: Record<string, unknown>;
  home?: boolean;
}
const { title, description, image, type = 'website', tracks, jsonLd, home = false } = Astro.props;
const site = Astro.site!;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image ?? u('og.jpg'), site).href;

const player = await Promise.all(
  tracks.map(async (t) => ({
    slug: t.slug,
    title: t.title,
    src: t.preview.src,
    env: t.preview.env,
    dropAt: t.preview.dropAt,
    hits: t.preview.hits,
    turns: t.preview.turns,
    duration: t.preview.duration,
    bpm: t.bpm,
    accent: t.accent,
    thumb: t.cover ? (await getImage({ src: t.cover, width: 192, height: 192, format: 'webp', quality: 75 })).src : u('brand/icon-192.png'),
    apple: t.links.apple,
    spotify: t.links.spotify,
    youtube: t.links.youtube,
    href: u(`t/${t.slug}/`),
  })),
);
const velvet = u('brand/velvet.webp');
const velvetPhone = u('brand/velvet-phone.webp');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#020204" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="rehndrop" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={u('favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={u('apple-touch-icon.png')} />
    <link rel="manifest" href={u('site.webmanifest')} />
    <!-- portrait phones get the 1080w velvet; everything else the 2560w one (4K screens swap in the 3840w below) -->
    <link rel="preload" as="image" href={velvetPhone} type="image/webp" media={PHONE_VELVET_MQ} fetchpriority="high" />
    <link rel="preload" as="image" href={velvet} type="image/webp" media={`not all and ${PHONE_VELVET_MQ}`} fetchpriority="high" />
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try { if (localStorage.getItem('index-view') === 'list') d.dataset.view = 'list'; } catch (e) {}
        if (/[?&]t=-?\d/.test(location.search)) d.classList.add('is-frozen');
        // a popstate gate that runs ahead of the client router's own listener (this script runs
        // before the router module loads); the contact sheet uses it so Back only closes the sheet
        var r = (window.__rehndrop = window.__rehndrop || {});
        addEventListener('popstate', function (e) {
          if (r.popGate && r.popGate(e)) e.stopImmediatePropagation();
        });
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <ClientRouter />
  </head>
  <body>
    {home && <a class="skip" href="#index">skip to tracks</a>}
    <div class="velvet" aria-hidden="true" transition:persist="velvet" style={`--velvet:url(${velvet});--velvet-phone:url(${velvetPhone})`}></div>
    <canvas class="lens" aria-hidden="true" data-lens transition:persist="lens"></canvas>
    <audio data-audio preload="none" playsinline transition:persist="audio"></audio>
    <div class="grain" aria-hidden="true"></div>
    <Header home={home} />
    <slot />
    <div class="drops-layer" aria-hidden="true" transition:persist="drops"><canvas class="drops" data-drops></canvas></div>
    <MiniPlayer />
    <ContactSheet />
    <p class="toast" data-toast role="status" aria-live="polite"></p>
    <script type="application/json" id="player-data" set:html={JSON.stringify(player)} />
    <script is:inline define:vars={{ base: BASE, sharp: velvet, phone: velvetPhone, phoneMq: PHONE_VELVET_MQ, sharp4k: u('brand/velvet-4k.webp'), fog: u('brand/velvet-fog.jpg'), velvet: curation.velvetTint ?? 'little' }}>
      window.__rehndrop = Object.assign(window.__rehndrop || {}, { base, sharp, fog, velvet, texAspect: 2560 / 1441 });
      // portrait phones: the lens reads the same 1080w portrait velvet the CSS layer shows
      if (matchMedia(phoneMq).matches) {
        window.__rehndrop.sharp = phone;
        window.__rehndrop.texAspect = 1080 / 1919;
      } else if (innerWidth * (devicePixelRatio || 1) > 2600) {
        // retina laptops and 4K screens get the 3840px velvet for both the CSS layer and the lens
        window.__rehndrop.sharp = sharp4k;
        document.querySelector('.velvet')?.style.setProperty('--velvet', 'url(' + sharp4k + ')');
      }
    </script>
    <script>
      import { startLens } from '../scripts/lens';
      import { startDrops } from '../scripts/drops';
      import { startPlayer, type Player, type PlayerTrack } from '../scripts/player';
      import { startSpotlight, startTilt } from '../scripts/ui';
      import { startList } from '../scripts/list';
      import { startSheet } from '../scripts/sheet';
      import { focusTitle, startNav } from '../scripts/nav';

      type Cfg = { base: string; sharp: string; fog: string; velvet: string; texAspect: number };
      const cfg = (window as unknown as { __rehndrop: Cfg }).__rehndrop;

      // Two kinds of setup. Once per visit: the player (its <audio> is a persisted element),
      // the lens and the water (persisted canvases), and every document-level listener.
      // Every page load, including the first: whatever lives in the page the router swapped in.
      let player: Player | null = null;
      let first = true;

      const boot = () => {
        const tracks = JSON.parse(document.getElementById('player-data')?.textContent || '[]') as PlayerTrack[];
        if (!player) {
          player = startPlayer(tracks, cfg.base, cfg.velvet);
          startNav(player);
          startSheet();
          startTilt();
          const canvas = document.querySelector<HTMLCanvasElement>('[data-lens]');
          if (canvas) startLens({ canvas, sharp: cfg.sharp, fog: cfg.fog, texAspect: cfg.texAspect });
          const water = document.querySelector<HTMLCanvasElement>('[data-drops]');
          if (water) startDrops(water);
        } else {
          player.updateTracks(tracks);
        }
        startSpotlight();
        startList();
        if (!first) focusTitle();
        first = false;
      };

      document.addEventListener('astro:page-load', boot);
    </script>
  </body>
</html>
